generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User { 
  id Int @id @default(autoincrement())
  name String?
  password String
  email String @unique
  room Room[]
}

model Element {
  id String @id @default(uuid())
  type Shapes
  x Int
  y Int
  width Int
  height Int
}

model Room {
  id String @id @default(uuid())
  adminId Int
  admin User @relation(fields: [adminId], references: [id])
}

enum Shapes { 
  rectangle
  arrow
  text
}